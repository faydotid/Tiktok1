{
  "name": "tebak-kata-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Game Tebak Kata (Wordle Indonesia) yang tebakannya datang dari chat TikTok Live",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:server\" \"npm:web\"",
    "server": "node server/index.js",
    "web": "vite",
    "build": "vite build",
    "test": "node scripts/selftest.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tiktok-live-connector": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
